name: build

on:
  push:
    branches: [${branch}]
  pull_request:

permissions:
  contents: read
  id-token: write

env:
  GITLEAKS_VERSION: 8.30.1
  TRIVY_VERSION: 0.76.0

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - uses: actions/setup-python@v7
        with:
          python-version: "3.13"

      - name: Run tests
        run: |
          pip install pytest
          pytest -q

  secrets:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0

      # The gitleaks GitHub Action needs a paid license in organization repos;
      # the CLI doesn't.
      - name: Scan for secrets
        run: |
          curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v$${GITLEAKS_VERSION}/gitleaks_$${GITLEAKS_VERSION}_linux_x64.tar.gz" | tar -xz gitleaks
          ./gitleaks git --redact --verbose .

  build:
    needs: [test, secrets]
    runs-on: ubuntu-latest
    env:
      PUSH: $${{ github.event_name == 'push' && vars.ECR_REPOSITORY_URL != '' }}
      IMAGE: $${{ vars.ECR_REPOSITORY_URL || 'app' }}:$${{ github.sha }}
    steps:
      - uses: actions/checkout@v7

      - uses: docker/setup-qemu-action@v4

      - uses: docker/setup-buildx-action@v4

      # Lambda needs a single-platform image, so no provenance index.
      - name: Build for arm64
        uses: docker/build-push-action@v7
        with:
          context: .
          platforms: linux/arm64
          provenance: false
          load: true
          tags: $${{ env.IMAGE }}

      - name: Scan the image
        run: |
          curl -fsSL "https://github.com/aquasecurity/trivy/releases/download/v$${TRIVY_VERSION}/trivy_$${TRIVY_VERSION}_Linux-64bit.tar.gz" | tar -xz trivy
          ./trivy image --exit-code 1 --severity CRITICAL --ignore-unfixed --no-progress "$IMAGE"

      - name: Get AWS credentials
        if: env.PUSH == 'true'
        uses: aws-actions/configure-aws-credentials@v6
        with:
          role-to-assume: $${{ vars.AWS_ROLE_ARN }}
          aws-region: $${{ vars.AWS_REGION }}

      - name: Log in to ECR
        if: env.PUSH == 'true'
        uses: aws-actions/amazon-ecr-login@v2

      - name: Push
        if: env.PUSH == 'true'
        run: |
          docker push "$IMAGE"
          echo "Pushed $IMAGE" >> "$GITHUB_STEP_SUMMARY"
