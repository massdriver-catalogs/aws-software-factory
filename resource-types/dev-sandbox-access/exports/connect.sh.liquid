#!/bin/sh
set -eu

NAME="{{ artifact.payload.name }}"
REGION="{{ artifact.payload.region }}"
{% if artifact.payload.role_arn %}
# The profile you already sign in with; the role is assumed from it.
SOURCE="${1:-${AWS_PROFILE:-default}}"

for tool in aws session-manager-plugin ssh ssh-keygen; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "Missing $tool. Install the AWS CLI and the Session Manager plugin: https://docs.aws.amazon.com/systems-manager/latest/userguide/install-plugin-macos-overview.html" >&2
    exit 1
  fi
done

if aws configure get aws_access_key_id --profile "$NAME" >/dev/null 2>&1; then
  echo "The AWS profile $NAME still has an access key from an older connect script, and it would be used instead of the role. Delete the [$NAME] section from ~/.aws/credentials and run this again." >&2
  exit 1
fi

aws configure set role_arn "{{ artifact.payload.role_arn }}" --profile "$NAME"
aws configure set source_profile "$SOURCE" --profile "$NAME"
aws configure set region "$REGION" --profile "$NAME"

if ! aws sts get-caller-identity --profile "$NAME" >/dev/null; then
  echo "Couldn't assume $NAME's role from the AWS profile $SOURCE. Sign in to it first (aws login, or aws sso login --profile $SOURCE), check that what aws sts get-caller-identity --profile $SOURCE prints is in the instance's Who can connect, or pass another profile: sh $0 <profile>" >&2
  exit 1
fi

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"
KEY="$HOME/.ssh/$NAME"
[ -f "$KEY" ] || ssh-keygen -q -t ed25519 -N "" -C "$NAME" -f "$KEY"

PROXY="$HOME/.ssh/$NAME-proxy"
cat > "$PROXY" <<EOF
#!/bin/sh
set -eu
unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
export AWS_PROFILE="$NAME" AWS_REGION="$REGION"
ID=\$(aws ec2 describe-instances \\
  --filters "Name=tag:Name,Values=$NAME" "Name=instance-state-name,Values=pending,running,stopping,stopped" \\
  --query 'Reservations[0].Instances[0].InstanceId' --output text)
STATE=\$(aws ec2 describe-instances --instance-ids "\$ID" --query 'Reservations[0].Instances[0].State.Name' --output text)
if [ "\$STATE" != "running" ]; then
  echo "Starting $NAME..." >&2
  [ "\$STATE" = "stopping" ] && aws ec2 wait instance-stopped --instance-ids "\$ID"
  aws ec2 start-instances --instance-ids "\$ID" >/dev/null
  aws ec2 wait instance-running --instance-ids "\$ID"
fi
for _ in \$(seq 1 60); do
  [ "\$(aws ssm describe-instance-information --filters "Key=InstanceIds,Values=\$ID" --query 'InstanceInformationList[0].PingStatus' --output text)" = "Online" ] && break
  sleep 3
done
aws ec2-instance-connect send-ssh-public-key --instance-id "\$ID" --instance-os-user dev \\
  --ssh-public-key "file://$KEY.pub" >/dev/null
exec aws ssm start-session --target "\$ID" --document-name AWS-StartSSHSession --parameters "portNumber=\$1"
EOF
chmod 700 "$PROXY"

CONFIG="$HOME/.ssh/config"
touch "$CONFIG"
if ! grep -q "^Host $NAME\$" "$CONFIG"; then
  cat >> "$CONFIG" <<EOF

Host $NAME
  User dev
  IdentityFile $KEY
  IdentitiesOnly yes
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  LogLevel ERROR
  ProxyCommand $PROXY %p
EOF
fi

echo "Ready. Connect with:  ssh $NAME"
echo "VS Code / Cursor:     Remote-SSH: Connect to Host... -> $NAME"
{% else %}
echo "No one can connect to $NAME from a terminal. Add what aws sts get-caller-identity --query Arn --output text prints to the instance's Who can connect, deploy it, and download this script again."
{% endif %}
{% if artifact.payload.browser_url %}
echo
echo "In the browser:       {{ artifact.payload.browser_url }}"
echo "App preview:          {{ artifact.payload.preview_url }}"
echo "Sign in as:           {{ artifact.payload.browser_username }} / {{ artifact.payload.browser_password }}"
echo "If the page doesn't load, the sandbox is stopped; ssh $NAME wakes it."
{% endif %}
